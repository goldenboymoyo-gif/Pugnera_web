# ---- Supabase backend configuration ----
# Copy this file to .env.local and fill in real values from your Supabase project
# (Dashboard > Settings > API).

# Public anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only service role key. NEVER expose this to the client.
# It is used for the register flow, admin operations and profile writes.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Set to true during local development so email confirmations are skipped.
# Turn this off in production.
SUPABASE_AUTO_CONFIRM=true